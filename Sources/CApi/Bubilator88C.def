; Module-definition file for the Windows DLL.
;
; Swift's @_cdecl gives C linkage but does NOT add __declspec(dllexport), so on
; Windows the symbols are not exported from the DLL by default. This .def file
; makes the linker export them. Referenced from Package.swift (CApi target
; linkerSettings, Windows-only).
LIBRARY Bubilator88C
EXPORTS
    b88_create
    b88_destroy
    b88_load_rom
    b88_load_rhythm_sample
    b88_mount_disk
    b88_eject_disk
    b88_set_write_protect
    b88_set_pseudo_stereo
    b88_d88_probe
    b88_set_dipsw1
    b88_apply_bootstrap
    b88_reset
    b88_install_ext_ram
    b88_set_clock_8mhz
    b88_get_clock_8mhz
    b88_is_400line
    b88_save_state
    b88_save_state_read
    b88_load_state
    b88_run_frame
    b88_press_key
    b88_release_key
    b88_render_rgba
    b88_drain_audio
    b88_audio_rate_control
    b88_disk_access
    b88_fdd_sound_events
